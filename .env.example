# Required for live OpenAI API examples.
OPENAI_API_KEY = 'your openai API key'

# Shared OpenAI client settings.
OPENAI_MODEL=gpt-5.6-luna 
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
LOG_LEVEL=INFO

# External resources used by examples.
IMAGE_URL=https://nyss.org/wp-content/uploads/2025/12/John-Constable-Scene-of-Flatford-Mill.jpeg
REMOTE_FILE_URL=https://www.berkshirehathaway.com/letters/2024ltr.pdf
MCP_SERVER_URL=https://dmcp-server.deno.dev/sse

# Local application configuration.
CONVERSATION_TTL_MINUTES=30
SESSION_TTL_MINUTES=30
PERSISTENT_CONVERSATION_DB=Conversation_API/conversation_persistent_memory_app/conversations.db
MULTI_USER_CONVERSATION_DB=Conversation_API/conversation_multi_user_temp_memory_app/conversations.db
WEATHER_APP_DB=Responses_API/weather_app_advanced_sessions/app.db
